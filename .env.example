# Overrides the API base URL entirely (any platform/device). Leave unset to use the
# platform-specific defaults in src/api/axiosInstance.ts.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# LAN IP of the machine running the backend, used only when testing on a physical
# device (Android/iOS) and EXPO_PUBLIC_API_URL is not set.
EXPO_PUBLIC_LAN_IP=

# RELEASE builds read `.env.production` instead of this file: Expo's dotenv precedence is
# `.env.<NODE_ENV>.local` > `.env.local` > `.env.<NODE_ENV>` > `.env`, and the Gradle bundle
# task runs `expo export:embed --dev false`, which sets NODE_ENV=production. `.env.production`
# therefore sets EXPO_PUBLIC_API_URL to the public HTTPS backend, while `expo start`
# (development) never loads it and keeps using the LAN/emulator defaults above.
# axiosInstance.ts rejects a non-https EXPO_PUBLIC_API_URL in release by design — a release
# build must never fall back to localhost / 127.0.0.1 / 10.0.2.2 / cleartext http.
